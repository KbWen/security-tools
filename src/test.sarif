{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.5.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "GhostCheck",
          "version": "1.2.2",
          "informationUri": "https://github.com/KbWen/security-tools",
          "rules": [
            {
              "id": "Agent Capability Registered",
              "shortDescription": {
                "text": "Audit log: Core capability detected in function:main."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "Agent Capability Registered",
          "message": {
            "text": "Audit log: Core capability detected in function:main."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/ghostcheck/cli.py"
                },
                "region": {
                  "startLine": 25
                }
              }
            }
          ],
          "level": "note"
        },
        {
          "ruleId": "Agent Capability Registered",
          "message": {
            "text": "Audit log: Core capability detected in function:__init__."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/ghostcheck/ignorefile.py"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ],
          "level": "note"
        },
        {
          "ruleId": "Agent Capability Registered",
          "message": {
            "text": "Audit log: Core capability detected in function:_load_from_package."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/ghostcheck/plugin_manager.py"
                },
                "region": {
                  "startLine": 20
                }
              }
            }
          ],
          "level": "note"
        },
        {
          "ruleId": "Agent Capability Registered",
          "message": {
            "text": "Audit log: Core capability detected in function:report."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/ghostcheck/reporters/html_reporter.py"
                },
                "region": {
                  "startLine": 15
                }
              }
            }
          ],
          "level": "note"
        },
        {
          "ruleId": "Agent Capability Registered",
          "message": {
            "text": "Audit log: Core capability detected in function:report."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/ghostcheck/reporters/sarif_reporter.py"
                },
                "region": {
                  "startLine": 15
                }
              }
            }
          ],
          "level": "note"
        }
      ]
    }
  ]
}