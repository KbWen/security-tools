#!/bin/sh
# GhostCheck Pre-commit Hook
# Prevents committing files with security risks.

echo "👻 Running GhostCheck pre-commit scan..."

# Run ghostcheck scan on staged changes for maximum efficiency
python -m ghostcheck.cli scan --staged --severity HIGH

# Capture exit code
RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo "❌ GhostCheck found high-severity risks in staged files. Commit aborted."
    echo "Run 'ghostcheck scan --staged' for details or fix the issues before committing."
    exit 1
fi

echo "✅ GhostCheck scan passed."
exit 0
